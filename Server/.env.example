# Application
NODE_ENV=development
PORT=9989

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# MySQL
MYSQL_ROOT_PASSWORD=root_password
DB_NAME=dlts_db
DB_USER=dlts_user
DB_PASSWORD=dlts_password

# Database URLs for Prisma (used locally, docker-compose overrides these)
DATABASE_URL="mysql://dlts_user:dlts_password@127.0.0.1:3307/dlts_db"
SHADOW_DATABASE_URL="mysql://root:root_password@127.0.0.1:3307/dlts_db_shadow"

# Redis
REDIS_URL=redis://127.0.0.1:6380
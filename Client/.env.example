# Copy this file to .env.development (for `npm run dev`) or .env.production
# and adjust as needed. Vite only exposes vars prefixed VITE_ to the client.

# Base URL the app makes all API calls against (see src/services/apiClient.ts).
# Points at the bundled json-server mock by default - see mock-server/README.md
# for how to run it, and README.md's "Connecting a real backend" section for
# what changes (nothing else) when pointing this at a real Node API instead.
VITE_API_BASE_URL=http://localhost:4000/api/v1
